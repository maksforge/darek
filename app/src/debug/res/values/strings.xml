<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only strings. `translatable="false"` on every one, for two reasons: Android lint would
    otherwise flag them as missing from every shipped locale, and `scripts/translation-gate.py`
    would ask you to translate a developer menu.

    This file is in `src/debug/res/`, so it is not merged into a release build at all.

    `app_name` is overridden here so the two copies on the phone are told apart at a glance.
    `applicationIdSuffix = ".debug"` already lets the debug build sit *beside* a Play copy, but both
    then carry the same name and icon — and picking the wrong one is how a local change gets tested
    against the store build, or a store bug gets chased in a build that never had it. A resource
    override rather than a `resValue`: `main/` already declares `app_name`, so a generated one would
    collide as a duplicate, while a debug `res/` overrides main's by name with no build logic at all.
    `scripts/project.py` reads this label back as DEBUG_APP_NAME, because OEM permission screens
    list the debug build under exactly this string.
-->
<resources>
    <string name="app_name" translatable="false">Darek debug</string>
    <string name="debug_voice" translatable="false">Darek\'s voice</string>
    <string name="debug_voice_text" translatable="false">Say this</string>
    <string name="debug_voice_next" translatable="false">Next sample</string>
    <string name="debug_voice_say" translatable="false">Say it</string>
    <string name="debug_voice_volume" translatable="false">Voice volume: %1$d%%</string>
    <string name="debug_probe" translatable="false">Recogniser probe</string>
    <string name="debug_probe_open" translatable="false">Open the probe</string>
    <string name="debug_probe_likeness" translatable="false">Match likeness: %1$d%%</string>
    <string name="debug_probe_likeness_note" translatable="false">How alike each heard word must be to the Command\'s. 100% is exact. „darek" and „otwórz bramę" are always exact.</string>
    <string name="debug_probe_start" translatable="false">Start</string>
    <string name="debug_probe_stop" translatable="false">Stop</string>
    <string name="debug_probe_free" translatable="false">Free decoding</string>
    <string name="debug_probe_reading" translatable="false">Reading mode: exact, shipping grammar, silent</string>
    <string name="debug_probe_preparing" translatable="false">Unpacking and loading the model…</string>
    <string name="debug_probe_partial" translatable="false">Hearing: %1$s</string>
</resources>
